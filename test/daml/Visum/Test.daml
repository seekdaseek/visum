-- | The arithmetic, proved on a real ledger before a line of TypeScript.
--
--   Every script here asserts. Nothing in this suite passes by printing a
--   number that a human then eyeballs.
module Visum.Test where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Optional (isNone)
import Daml.Script
import Visum
import Visum.Prove

-- ---------------------------------------------------------------------------
-- Fixtures
-- ---------------------------------------------------------------------------

data Cast = Cast
  with
    operator : Party
    counterparty : Party
    auditor : Party

allocCast : Script Cast
allocCast = do
  operator <- allocateParty "operator"
  counterparty <- allocateParty "counterparty"
  auditor <- allocateParty "auditor"
  pure Cast with operator, counterparty, auditor

-- | Create n settlements under a scope tag, withholding the auditor from the
--   first k of them. Returns nothing: the count is not handed onward.
seed : Cast -> Text -> Int -> Int -> Script ()
seed cast scopeTag n k =
  forA_ [1 .. n] $ \i ->
    submit cast.operator do
      createCmd
        Settlement with
          operator = cast.operator
          counterparty = cast.counterparty
          payload = "settlement-" <> show i
          scopeTag
          amount = amountFor i
          disclosed = if i <= k then [] else [cast.auditor]

-- | A deliberately uneven amount per settlement, in minor units.
--
--   Flat amounts would make value coverage a restatement of count coverage
--   and the value tests would prove nothing. The first settlements are the
--   withheld ones in `seed`, so this also means the withheld set carries
--   a different share of value than of count.
amountFor : Int -> Int
amountFor i = 100 * i * i + 50

declareScope : Cast -> Text -> Int -> Script (ContractId ScopeStatement)
declareScope cast scopeTag declaredTotal =
  declareScopeWith cast scopeTag declaredTotal [cast.counterparty]

declareScopeWith :
  Cast -> Text -> Int -> [Party] -> Script (ContractId ScopeStatement)
declareScopeWith cast scopeTag declaredTotal expectedAttestors = do
  -- Declare the value the operator can actually see, so the count and value
  -- declarations are independently honest by default.
  mine <- query @Settlement cast.operator
  let declaredValue =
        foldl (\acc (_, x) -> if x.scopeTag == scopeTag then acc + x.amount else acc) 0 mine
  now <- getTime
  submit cast.operator do
    createCmd
      ScopeStatement with
        operator = cast.operator
        auditor = cast.auditor
        scopeTag
        periodStart = now
        periodEnd = now
        templatesInScope = ["#visum:Visum:Settlement"]
        declaredTotal
        declaredValue
        expectedAttestors
        scopeHash = "sha256:" <> scopeTag
-- ---------------------------------------------------------------------------
-- 1. Projection: who sees how many
-- ---------------------------------------------------------------------------

testProjection : Script ()
testProjection = do
  cast <- allocCast
  let scopeTag = "projection"
      n = 12
      k = 5
  seed cast scopeTag n k

  opSees <- projectionOf cast.operator scopeTag
  cpSees <- projectionOf cast.counterparty scopeTag
  audSees <- projectionOf cast.auditor scopeTag

  length opSees === n
  length cpSees === n
  length audSees === n - k

  -- The withheld contracts are absent from the auditor's projection, not
  -- present-and-empty. There is no residue to count.
  assertMsg
    "withheld settlements leave nothing behind in the auditor's projection"
    (all (`elem` opSees) audSees && length audSees == n - k)

-- ---------------------------------------------------------------------------
-- 2. Stakeholders: signatories union observers, and the ledger agrees
-- ---------------------------------------------------------------------------

testStakeholders : Script ()
testStakeholders = do
  cast <- allocCast
  let scopeTag = "stakeholders"
      n = 10
      k = 4
  seed cast scopeTag n k

  everything <- query @Settlement cast.operator
  let scoped = [(cid, s) | (cid, s) <- everything, s.scopeTag == scopeTag]

  assertMsg "fixture actually created contracts" (length scoped == n)

  forA_ scoped $ \(_, s) -> do
    let sigs = signatory s
        obs = normalisedObservers s

    assertMsg
      "observers never repeat a signatory"
      (all (`notElem` sigs) obs)

    assertMsg
      "stakeholders equal signatories union observers"
      (sort (stakeholdersOf s) == sort (sigs <> obs))

    assertMsg
      "the operator is the only signatory"
      (sigs == [cast.operator])

  -- The strong one: the stakeholder set computed off each contract predicts
  -- the auditor's real projection exactly, contract for contract.
  predicted <- pure $ sort [cid | (cid, s) <- scoped, isStakeholder cast.auditor s]
  actual <- projectionOf cast.auditor scopeTag
  assertMsg
    "stakeholder analysis predicts the auditor's projection exactly"
    (predicted == actual)

-- ---------------------------------------------------------------------------
-- 3. Honest proof: ratio derived from the ledger, not from the seeding code
-- ---------------------------------------------------------------------------

testHonestProof : Script ()
testHonestProof = do
  cast <- allocCast
  let scopeTag = "honest"
      n = 20
      k = 7
  seed cast scopeTag n k
  _ <- declareScope cast scopeTag n
  _ <- attestAs cast.counterparty cast.operator cast.auditor scopeTag

  cid <- proveCoverage cast.operator cast.operator cast.auditor scopeTag
  Some proof <- queryContractId cast.auditor cid

  proof.auditorVisible === n - k
  proof.declaredTotal === n
  proof.attestedFloor === n
  proof.ratio === 0.65
  proof.ratio === coverageRatio n n (n - k)

  assertMsg
    "an honest declaration produces no concealment signal"
    (not (concealmentSignal proof.declaredTotal proof.attestedFloor))

  -- The auditor recomputes the published proof from its own projection plus
  -- the two signed claims. It does not have to trust the prover.
  view <- auditorAlone cast.auditor scopeTag
  view.visible === proof.auditorVisible
  view.declaredTotal === Some proof.declaredTotal
  view.attestedFloor === Some proof.attestedFloor
  assertMsg "the auditor can verify the published proof unaided" view.canComputeCoverage

-- ---------------------------------------------------------------------------
-- 4. Concealment: the operator under-declares and the attested floor wins
-- ---------------------------------------------------------------------------

testConcealment : Script ()
testConcealment = do
  cast <- allocCast
  let scopeTag = "concealment"
      n = 30
      k = 12
      disclosedCount = n - k
  seed cast scopeTag n k

  -- The operator declares a scope that matches exactly what it disclosed.
  -- Against its own declaration it looks perfect.
  _ <- declareScope cast scopeTag disclosedCount
  -- The counterparty, which is a stakeholder on every settlement, signs for
  -- what it actually saw. The operator cannot suppress this.
  _ <- attestAs cast.counterparty cast.operator cast.auditor scopeTag

  cid <- proveCoverage cast.operator cast.operator cast.auditor scopeTag
  Some proof <- queryContractId cast.auditor cid

  proof.declaredTotal === disclosedCount
  proof.attestedFloor === n
  proof.auditorVisible === disclosedCount

  assertMsg
    "the attested floor exceeds the declared total"
    (concealmentSignal proof.declaredTotal proof.attestedFloor)

  assertMsg
    "the proof records both numbers rather than picking one"
    (proof.declaredTotal /= proof.attestedFloor)

  -- The denominator is the floor, not the declaration.
  coverageDenominator proof.declaredTotal proof.attestedFloor proof.auditorVisible === n
  proof.denominatorSource === AttestedFloor
  proof.ratio === coverageRatio disclosedCount n disclosedCount
  proof.ratio === 0.6

  -- Without the attestation the same ledger would have published 100%.
  assertMsg
    "scoring against the declaration alone would have read one hundred percent"
    (coverageRatio disclosedCount 0 disclosedCount == 1.0)
  assertMsg
    "the attestation is what stops it reading one hundred percent"
    (proof.ratio < 1.0)

-- ---------------------------------------------------------------------------
-- 5. The prover cannot be handed the answer
-- ---------------------------------------------------------------------------

testProverCannotPeek : Script ()
testProverCannotPeek = do
  cast <- allocCast
  let scopeTag = "nopeek"
      n = 20
      k = 8
      trueVisible = n - k

      -- A deliberately wrong "ground truth" of the kind .visum/ground-truth.json
      -- holds. A prover that read it would publish this number.
      bogusGroundTruthVisible = 1
      bogusGroundTruthTotal = 99

  seed cast scopeTag n k
  _ <- declareScope cast scopeTag n
  _ <- attestAs cast.counterparty cast.operator cast.auditor scopeTag

  -- Guard against a vacuous test: the shortcut answer must actually differ
  -- from the derived one, or this script proves nothing.
  assertMsg
    "the shortcut value differs from the truth, so this test discriminates"
    (bogusGroundTruthVisible /= trueVisible && bogusGroundTruthTotal /= n)

  derived <- deriveCoverage cast.operator cast.auditor scopeTag

  derived.auditorVisible === trueVisible
  derived.declaredTotal === n
  assertMsg
    "the prover followed the ledger, not the supplied ground truth"
    (derived.auditorVisible /= bogusGroundTruthVisible)
  assertMsg
    "the prover's denominator came from the ledger, not the supplied total"
    ( coverageDenominator derived.declaredTotal derived.attestedFloor derived.auditorVisible
        /= bogusGroundTruthTotal
    )

-- ---------------------------------------------------------------------------
-- 6. A forged ratio cannot reach the ledger
-- ---------------------------------------------------------------------------

testForgedRatioRejected : Script ()
testForgedRatioRejected = do
  cast <- allocCast
  let scopeTag = "forgery"
      n = 25
      k = 10
  seed cast scopeTag n k
  _ <- declareScope cast scopeTag n
  _ <- attestAs cast.counterparty cast.operator cast.auditor scopeTag
  now <- getTime

  let forged ratio =
        CoverageProof with
          prover = cast.operator
          operator = cast.operator
          auditor = cast.auditor
          scopeTag
          scopeHash = "sha256:forgery"
          declaredTotal = n
          attestedFloor = n
          auditorVisible = n - k
          ratio
          attestors = [cast.counterparty]
          expectedAttestors = [cast.counterparty]
          attestorCount = 1
          expectedAttestorCount = 1
          denominatorSource = denominatorSourceOf n n (n - k)
          auditorVisibleValue = 600
          declaredValue = 1000
          attestedValueFloor = 1000
          valueRatio = coverageRatio 1000 1000 600
          valueDenominatorSource = denominatorSourceOf 1000 1000 600
          computedAt = now

  -- A flattering ratio that does not follow from the contract's own numbers
  -- is rejected by the template's ensure clause.
  submitMustFail cast.operator do createCmd (forged 1.0)
  submitMustFail cast.operator do createCmd (forged 0.0)
  submitMustFail cast.operator do createCmd (forged 0.61)

  -- The honest one commits.
  _ <- submit cast.operator do createCmd (forged (coverageRatio n n (n - k)))
  pure ()

-- ---------------------------------------------------------------------------
-- 7. The control case: the auditor alone cannot tell
-- ---------------------------------------------------------------------------

testAuditorAloneCannotComputeCoverage : Script ()
testAuditorAloneCannotComputeCoverage = do
  cast <- allocCast
  let scopeTag = "alone"
      n = 25
      k = 9
  seed cast scopeTag n k
  -- No ScopeStatement. No attestation. Just the ledger as the auditor finds it.

  view <- auditorAlone cast.auditor scopeTag

  view.visible === n - k
  assertMsg "the auditor holds no declared total" (isNone view.declaredTotal)
  assertMsg "the auditor holds no attested floor" (isNone view.attestedFloor)
  assertMsg
    "the auditor cannot compute its own coverage"
    (not view.canComputeCoverage)

-- | Two worlds the auditor cannot tell apart.
--
--   Scope A: 25 settlements exist and 9 are withheld from the auditor.
--   Scope B: 16 settlements exist and nothing is withheld.
--
--   The auditor's projection is the same size in both. This is the whole
--   problem, asserted.
testAuditorCannotDistinguishWithheldFromAbsent : Script ()
testAuditorCannotDistinguishWithheldFromAbsent = do
  cast <- allocCast
  seed cast "worldA" 25 9
  seed cast "worldB" 16 0

  a <- auditorAlone cast.auditor "worldA"
  b <- auditorAlone cast.auditor "worldB"

  a.visible === 16
  b.visible === 16

  assertMsg
    "the auditor's view of a concealing world is identical to its view of an honest smaller one"
    (a == b)

  -- The operator knows they differ. The auditor has no way to.
  opA <- projectionOf cast.operator "worldA"
  opB <- projectionOf cast.operator "worldB"
  assertMsg "the two worlds genuinely differ on the ledger" (length opA /= length opB)

-- ---------------------------------------------------------------------------
-- 8. Attested floor sums across distinct counterparties, once each
-- ---------------------------------------------------------------------------

testAttestedFloorAcrossCounterparties : Script ()
testAttestedFloorAcrossCounterparties = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"
  let scopeTag = "multi"

  -- 6 settlements with cpA, 4 of them withheld from the auditor.
  forA_ [1 .. 6] $ \i ->
    submit operator do
      createCmd
        Settlement with
          operator
          counterparty = cpA
          payload = "a-" <> show i
          scopeTag
          amount = amountFor i
          disclosed = if i <= 4 then [] else [auditor]
  -- 4 settlements with cpB, all disclosed.
  forA_ [1 .. 4] $ \i ->
    submit operator do
      createCmd
        Settlement with
          operator
          counterparty = cpB
          payload = "b-" <> show i
          scopeTag
          amount = amountFor i
          disclosed = [auditor]

  _ <- attestAs cpA operator auditor scopeTag
  _ <- attestAs cpB operator auditor scopeTag
  -- cpA attests a second time; the floor must not double-count it.
  _ <- attestAs cpA operator auditor scopeTag

  derived <- deriveCoverage operator auditor scopeTag

  derived.attestedFloor === 10
  derived.auditorVisible === 6
  derived.ratio === coverageRatio 0 10 6
  derived.ratio === 0.6

-- | Duplicate attestations from one party must not inflate the floor.
testDuplicateAttestationDoesNotInflate : Script ()
testDuplicateAttestationDoesNotInflate = do
  attestedFloorFrom [] === 0
  attestedFloorFrom [(p1, 5)] === 5
  attestedFloorFrom [(p1, 5), (p1, 5)] === 5
  attestedFloorFrom [(p1, 5), (p1, 7)] === 7
  attestedFloorFrom [(p1, 5), (p2, 4)] === 9
  attestedFloorFrom [(p1, 5), (p2, 4), (p1, 5)] === 9
  where
    p1 = partyFromTextOrError "cpA"
    p2 = partyFromTextOrError "cpB"

partyFromTextOrError : Text -> Party
partyFromTextOrError t = case partyFromText t of
  Some p -> p
  None -> error ("bad party literal: " <> t)

-- ---------------------------------------------------------------------------
-- 9. Zero denominator is defined, not undefined
-- ---------------------------------------------------------------------------

testEmptyScope : Script ()
testEmptyScope = do
  cast <- allocCast
  derived <- deriveCoverage cast.operator cast.auditor "empty"
  derived.declaredTotal === 0
  derived.attestedFloor === 0
  derived.auditorVisible === 0
  derived.ratio === 0.0

-- ---------------------------------------------------------------------------
-- 10. Decimal behaviour, because the acceptance test allows no tolerances
-- ---------------------------------------------------------------------------

-- | `ratio` is a Daml `Decimal`, i.e. `Numeric 10`. A non-terminating ratio is
--   rounded to ten decimal places, so the stored ratio is not the exact
--   rational.
--
--   This is safe for exact comparison only because both sides of any
--   comparison run the same `coverageRatio`. The twenty-seed eval must compare
--   the integers -- auditorVisible, declaredTotal, attestedFloor -- for its
--   exactness claim, and must not reconstruct the ratio in IEEE-754 floating
--   point and expect equality.
testRatioIsRoundedNotExact : Script ()
testRatioIsRoundedNotExact = do
  -- Terminating ratios are exact.
  coverageRatio 20 0 13 === 0.65
  coverageRatio 30 0 18 === 0.6
  coverageRatio 4 0 1 === 0.25

  -- 7/13 does not terminate in base 10 and is therefore rounded.
  assertMsg
    "a non-terminating ratio is rounded, so it does not invert exactly"
    (coverageRatio 13 0 7 * 13.0 /= 7.0)

  -- Rounded or not, the same inputs always give the same output, which is
  -- what exact comparison actually depends on.
  coverageRatio 13 0 7 === coverageRatio 13 0 7
  coverageRatio 101 0 97 === coverageRatio 101 0 97

  -- Full coverage is exactly 1.0, and nothing exceeds it.
  coverageRatio 50 0 50 === 1.0
  coverageRatio 50 50 50 === 1.0

-- ---------------------------------------------------------------------------
-- 11. Attestation coverage: the same ratio can carry very different weight
-- ---------------------------------------------------------------------------

-- | Seed a scope spread over several counterparties.
--   Each entry is (counterparty, total settlements, how many are withheld).
seedMulti : Party -> Party -> Text -> [(Party, Int, Int)] -> Script ()
seedMulti operator auditor scopeTag plan =
  forA_ plan $ \(cp, total, hidden) ->
    forA_ [1 .. total] $ \i ->
      submit operator do
        createCmd
          Settlement with
            operator
            counterparty = cp
            payload = scopeTag <> "-" <> show i
            scopeTag
            amount = amountFor i
            disclosed = if i <= hidden then [] else [auditor]

declareScopeFor :
  Party -> Party -> Text -> Int -> [Party] -> Script (ContractId ScopeStatement)
declareScopeFor operator auditor scopeTag declaredTotal expectedAttestors = do
  now <- getTime
  mine <- query @Settlement operator
  let declaredValue =
        foldl (\acc (_, x) -> if x.scopeTag == scopeTag then acc + x.amount else acc) 0 mine
  submit operator do
    createCmd
      ScopeStatement with
        operator
        auditor
        scopeTag
        periodStart = now
        periodEnd = now
        templatesInScope = ["#visum:Visum:Settlement"]
        declaredTotal
        declaredValue
        expectedAttestors
        scopeHash = "sha256:" <> scopeTag

-- | Two scopes with identical settlements, identical declarations and
--   therefore an identical ratio. One is attested by all four counterparties,
--   the other by one of four.
--
--   A reader must be able to tell them apart. Before attestor counts were
--   recorded, the proof could not.
testAttestationCoverageIsRecorded : Script ()
testAttestationCoverageIsRecorded = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"
  cpC <- allocateParty "cpC"
  cpD <- allocateParty "cpD"

  -- 20 settlements, 8 withheld from the auditor, 12 visible.
  let plan = [(cpA, 8, 3), (cpB, 6, 2), (cpC, 4, 2), (cpD, 2, 1)]
      expected = [cpA, cpB, cpC, cpD]
      trueTotal = 20
      visible = 12

  seedMulti operator auditor "full" plan
  seedMulti operator auditor "partial" plan

  -- The operator declares the same honest total for both scopes.
  _ <- declareScopeFor operator auditor "full" trueTotal expected
  _ <- declareScopeFor operator auditor "partial" trueTotal expected

  -- Every counterparty stands behind the first scope.
  forA_ [cpA, cpB, cpC, cpD] $ \cp -> attestAs cp operator auditor "full"
  -- Only one stands behind the second.
  _ <- attestAs cpA operator auditor "partial"

  fullCid <- proveCoverage operator operator auditor "full"
  partCid <- proveCoverage operator operator auditor "partial"
  Some full <- queryContractId auditor fullCid
  Some part <- queryContractId auditor partCid

  -- Same numerator, same denominator, same ratio.
  full.auditorVisible === visible
  part.auditorVisible === visible
  full.declaredTotal === trueTotal
  part.declaredTotal === trueTotal
  full.ratio === 0.6
  part.ratio === 0.6
  assertMsg "the two proofs publish the same ratio" (full.ratio == part.ratio)

  -- The partial run has a lower attested floor.
  full.attestedFloor === 20
  part.attestedFloor === 8
  assertMsg
    "partial attestation publishes a lower attested floor"
    (part.attestedFloor < full.attestedFloor)

  -- And a visibly lower attestor count.
  full.attestorCount === 4
  part.attestorCount === 1
  full.expectedAttestorCount === 4
  part.expectedAttestorCount === 4
  assertMsg
    "partial attestation publishes a visibly lower attestor count"
    (part.attestorCount < full.attestorCount)

  -- "0.60, attested by 4 of 4" is distinguishable from
  -- "0.60, attested by 1 of 4" from the proof alone.
  assertMsg
    "the two proofs are distinguishable despite the identical ratio"
    (full /= part)

-- | The proof must not claim full attestation it did not have.
testProofCannotOverstateAttestation : Script ()
testProofCannotOverstateAttestation = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"
  cpC <- allocateParty "cpC"
  cpD <- allocateParty "cpD"

  let plan = [(cpA, 8, 3), (cpB, 6, 2), (cpC, 4, 2), (cpD, 2, 1)]
      expected = [cpA, cpB, cpC, cpD]

  seedMulti operator auditor "understated" plan
  _ <- declareScopeFor operator auditor "understated" 20 expected
  _ <- attestAs cpA operator auditor "understated"

  cid <- proveCoverage operator operator auditor "understated"
  Some proof <- queryContractId auditor cid

  assertMsg
    "the proof does not report full attestation when it did not have it"
    (not (fullyAttested proof.expectedAttestors proof.attestors))

  assertMsg
    "the attestors recorded are exactly those that actually signed"
    (proof.attestors == [cpA])

  assertMsg
    "the three silent counterparties are identifiable from the proof"
    (sort (missingAttestors proof.expectedAttestors proof.attestors)
       == sort [cpB, cpC, cpD])

  -- Guard against the assertion going vacuous: full attestation must
  -- genuinely register as full, or the predicate above proves nothing.
  forA_ [cpB, cpC, cpD] $ \cp -> attestAs cp operator auditor "understated"
  cid2 <- proveCoverage operator operator auditor "understated"
  Some proof2 <- queryContractId auditor cid2
  assertMsg
    "once everyone attests, the proof does report full attestation"
    (fullyAttested proof2.expectedAttestors proof2.attestors)
  proof2.attestorCount === 4
  missingAttestors proof2.expectedAttestors proof2.attestors === []

-- | A counterparty that attests without being declared is itself a signal:
--   the operator's expected set was incomplete. This must not be rejected.
testUndeclaredAttestorIsRecorded : Script ()
testUndeclaredAttestorIsRecorded = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"

  seedMulti operator auditor "undeclared" [(cpA, 5, 1), (cpB, 5, 1)]
  -- The operator declares only one counterparty.
  _ <- declareScopeFor operator auditor "undeclared" 10 [cpA]
  _ <- attestAs cpA operator auditor "undeclared"
  _ <- attestAs cpB operator auditor "undeclared"

  cid <- proveCoverage operator operator auditor "undeclared"
  Some proof <- queryContractId auditor cid

  proof.expectedAttestorCount === 1
  proof.attestorCount === 2
  assertMsg
    "an attestor the operator did not declare is recorded, not rejected"
    (proof.attestorCount > proof.expectedAttestorCount)
  assertMsg
    "the undeclared counterparty appears in the attestor set"
    (cpB `elem` proof.attestors)

-- ---------------------------------------------------------------------------
-- 12. The denominator is capped, and the cap is never silent
-- ---------------------------------------------------------------------------

-- | The denominator is max(declaredTotal, attestedFloor, auditorVisible), so
--   the ratio can no longer exceed 1.0.
--
--   But a cap on its own would be a lie. When the auditor's own count is the
--   only thing holding the denominator up, the ratio reads 1.0 purely because
--   nobody corroborated the population -- every settlement the auditor was
--   shown is in the denominator and nothing else is, so full coverage is
--   arithmetically guaranteed and means nothing. Silently smoothing that into
--   a perfect score is the exact failure visum exists to prevent, so the proof
--   names the winning term.
--
--   Here: 20 settlements, 8 withheld, the auditor sees 12; only one of two
--   counterparties attests, so the floor is 8 and the declaration is absent.
testRatioCanExceedOneUnderPartialAttestation : Script ()
testRatioCanExceedOneUnderPartialAttestation = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"

  seedMulti operator auditor "aboveone" [(cpA, 8, 3), (cpB, 12, 5)]
  _ <- attestAs cpA operator auditor "aboveone"

  d <- deriveCoverage operator auditor "aboveone"

  d.declaredTotal === 0
  d.attestedFloor === 8
  d.auditorVisible === 12

  -- Capped, where the old two-term denominator published 1.5.
  d.ratio === 1.0
  assertMsg "the ratio is capped at 1.0" (d.ratio <= 1.0)
  assertMsg
    "the pre-fix two-term denominator would have exceeded 1.0"
    (intToDecimal d.auditorVisible / intToDecimal (max d.declaredTotal d.attestedFloor) > 1.0)

  -- And the cap is visible, not silent.
  d.denominatorSource === AuditorVisible
  assertMsg
    "the proof names the auditor's own count as the denominator source"
    (uncorroboratedDenominator d.declaredTotal d.attestedFloor d.auditorVisible)
  assertMsg
    "a 1.0 from an uncorroborated denominator is not a passing grade"
    (d.ratio == 1.0 && d.denominatorSource == AuditorVisible)

-- | A proof cannot claim an independent denominator when the auditor's own
--   count is what actually won. The ledger rejects it at commit time.
testCannotClaimIndependentDenominator : Script ()
testCannotClaimIndependentDenominator = do
  operator <- allocateParty "operator"
  auditor <- allocateParty "auditor"
  cpA <- allocateParty "cpA"
  cpB <- allocateParty "cpB"
  now <- getTime

  seedMulti operator auditor "claim" [(cpA, 8, 3), (cpB, 12, 5)]
  _ <- attestAs cpA operator auditor "claim"

  d <- deriveCoverage operator auditor "claim"
  -- auditorVisible 12 strictly exceeds declared 0 and floor 8.
  d.denominatorSource === AuditorVisible

  let proofWith src =
        CoverageProof with
          prover = operator
          operator
          auditor
          scopeTag = "claim"
          scopeHash = "sha256:claim"
          declaredTotal = d.declaredTotal
          attestedFloor = d.attestedFloor
          auditorVisible = d.auditorVisible
          ratio = d.ratio
          attestors = d.attestors
          expectedAttestors = d.expectedAttestors
          attestorCount = length d.attestors
          expectedAttestorCount = length d.expectedAttestors
          denominatorSource = src
          auditorVisibleValue = d.auditorVisibleValue
          declaredValue = d.declaredValue
          attestedValueFloor = d.attestedValueFloor
          valueRatio = d.valueRatio
          valueDenominatorSource = d.valueDenominatorSource
          computedAt = now

  -- Dressing an uncorroborated 1.0 up as counterparty-backed is refused.
  submitMustFail operator do createCmd (proofWith AttestedFloor)
  -- So is passing it off as the operator's declaration.
  submitMustFail operator do createCmd (proofWith DeclaredTotal)

  -- The honest labelling commits.
  _ <- submit operator do createCmd (proofWith AuditorVisible)
  pure ()

-- | Tie-breaking: the source resolves toward the strongest corroboration, so
--   AuditorVisible is named only when it strictly exceeds the other two.
testDenominatorSourceTieBreaking : Script ()
testDenominatorSourceTieBreaking = do
  -- Attested floor is the max, alone or tied: the strongest term wins.
  denominatorSourceOf 10 20 5 === AttestedFloor
  denominatorSourceOf 20 20 5 === AttestedFloor
  denominatorSourceOf 10 20 20 === AttestedFloor
  denominatorSourceOf 20 20 20 === AttestedFloor

  -- Declaration is the max, and ties with the auditor's own count go to it:
  -- the population was still bounded by something outside the auditor.
  denominatorSourceOf 20 10 5 === DeclaredTotal
  denominatorSourceOf 20 10 20 === DeclaredTotal

  -- Only a strict excess over both is uncorroborated.
  denominatorSourceOf 10 8 20 === AuditorVisible
  denominatorSourceOf 0 0 5 === AuditorVisible

  -- And in that case the ratio is exactly 1.0, every time, by construction.
  coverageRatio 10 8 20 === 1.0
  coverageRatio 0 0 5 === 1.0
  coverageRatio 0 0 137 === 1.0
  assertMsg
    "an uncorroborated denominator always yields exactly 1.0"
    (coverageRatio 1 2 99 == 1.0 && denominatorSourceOf 1 2 99 == AuditorVisible)

-- ---------------------------------------------------------------------------
-- 13. Value coverage: the number an auditor actually cares about
-- ---------------------------------------------------------------------------

-- | Seed a scope from an explicit list of (amount in minor units, disclosed).
seedAmounts : Party -> Party -> Party -> Text -> [(Int, Bool)] -> Script ()
seedAmounts operator counterparty auditor scopeTag rows =
  forA_ (zip [1 .. length rows] rows) $ \(i, (amount, disclosed)) ->
    submit operator do
      createCmd
        Settlement with
          operator
          counterparty
          payload = scopeTag <> "-" <> show i
          scopeTag
          amount
          disclosed = if disclosed then [auditor] else []

-- | The same ledger, scored two ways, giving opposite verdicts.
--
--   Ten settlements: one worth 1,000,000 minor units and nine worth 100 each.
--
--   * scope "whale" discloses only the big one. Count coverage reads 0.10.
--     Value coverage reads 0.9991. Ten percent of the contracts, and
--     essentially all of the money.
--   * scope "dust" discloses only the nine small ones. Count coverage reads
--     0.90 -- which looks like a well-run audit -- while value coverage reads
--     0.0009. Ninety percent of the contracts and a thousandth of the money.
--
--   An auditor told "90% covered" and nothing else has been badly misled.
--   That is why the proof carries both.
testValueCoverageDivergesFromCountCoverage : Script ()
testValueCoverageDivergesFromCountCoverage = do
  operator <- allocateParty "operator"
  counterparty <- allocateParty "counterparty"
  auditor <- allocateParty "auditor"

  let big = 1000000
      small = 100
      totalValue = big + 9 * small -- 1,000,900

  -- whale: only the big settlement is disclosed
  seedAmounts operator counterparty auditor "whale" ((big, True) :: replicate 9 (small, False))
  -- dust: only the nine small ones are disclosed
  seedAmounts operator counterparty auditor "dust" ((big, False) :: replicate 9 (small, True))

  forA_ ["whale", "dust"] $ \tag -> do
    _ <- declareScopeFor operator auditor tag 10 [counterparty]
    attestAs counterparty operator auditor tag

  whale <- deriveCoverage operator auditor "whale"
  dust <- deriveCoverage operator auditor "dust"

  -- the attested floors are the truth in both scopes
  whale.attestedFloor === 10
  whale.attestedValueFloor === totalValue
  dust.attestedFloor === 10
  dust.attestedValueFloor === totalValue

  -- whale: few contracts, nearly all the money
  whale.auditorVisible === 1
  whale.auditorVisibleValue === big
  whale.ratio === coverageRatio 10 10 1
  whale.ratio === 0.1
  whale.valueRatio === coverageRatio totalValue totalValue big

  -- dust: most contracts, almost none of the money
  dust.auditorVisible === 9
  dust.auditorVisibleValue === 9 * small
  dust.ratio === 0.9
  dust.valueRatio === coverageRatio totalValue totalValue (9 * small)

  -- The two measures disagree, and in opposite directions.
  assertMsg
    "whale: value coverage is far higher than count coverage"
    (whale.valueRatio > whale.ratio)
  assertMsg
    "dust: value coverage is far lower than count coverage"
    (dust.valueRatio < dust.ratio)
  assertMsg
    "count coverage alone would rank dust above whale"
    (dust.ratio > whale.ratio)
  assertMsg
    "value coverage ranks them the other way round"
    (dust.valueRatio < whale.valueRatio)

  -- Concretely: a 0.90 count ratio hiding a value ratio under one percent.
  assertMsg
    "dust publishes high count coverage and negligible value coverage"
    (dust.ratio == 0.9 && dust.valueRatio < 0.01)

-- | The value ratio is bound to its own integers, exactly like the count
--   ratio. A flattering value figure cannot reach the ledger.
testForgedValueRatioRejected : Script ()
testForgedValueRatioRejected = do
  operator <- allocateParty "operator"
  counterparty <- allocateParty "counterparty"
  auditor <- allocateParty "auditor"
  now <- getTime

  seedAmounts operator counterparty auditor "vforge" [(900, True), (100, False)]
  _ <- declareScopeFor operator auditor "vforge" 2 [counterparty]
  _ <- attestAs counterparty operator auditor "vforge"
  d <- deriveCoverage operator auditor "vforge"

  d.auditorVisibleValue === 900
  d.attestedValueFloor === 1000

  let proofWith vRatio vSrc =
        CoverageProof with
          prover = operator
          operator
          auditor
          scopeTag = "vforge"
          scopeHash = "sha256:vforge"
          declaredTotal = d.declaredTotal
          attestedFloor = d.attestedFloor
          auditorVisible = d.auditorVisible
          ratio = d.ratio
          attestors = d.attestors
          expectedAttestors = d.expectedAttestors
          attestorCount = length d.attestors
          expectedAttestorCount = length d.expectedAttestors
          denominatorSource = d.denominatorSource
          auditorVisibleValue = d.auditorVisibleValue
          declaredValue = d.declaredValue
          attestedValueFloor = d.attestedValueFloor
          valueRatio = vRatio
          valueDenominatorSource = vSrc
          computedAt = now

  -- A value ratio that does not follow from its own numbers is refused.
  submitMustFail operator do createCmd (proofWith 1.0 d.valueDenominatorSource)
  submitMustFail operator do createCmd (proofWith 0.0 d.valueDenominatorSource)
  submitMustFail operator do createCmd (proofWith 0.91 d.valueDenominatorSource)
  -- So is mislabelling which floor held the value denominator up.
  submitMustFail operator do createCmd (proofWith d.valueRatio AuditorVisible)

  -- The honest one commits.
  _ <- submit operator do createCmd (proofWith d.valueRatio d.valueDenominatorSource)
  pure ()

-- | Value coverage carries its own denominator source, and an uncorroborated
--   value denominator is called out the same way an uncorroborated count is.
testValueDenominatorSourceIsIndependent : Script ()
testValueDenominatorSourceIsIndependent = do
  operator <- allocateParty "operator"
  counterparty <- allocateParty "counterparty"
  auditor <- allocateParty "auditor"

  -- No scope statement and no attestation: both denominators rest on the
  -- auditor's own view alone.
  seedAmounts operator counterparty auditor "vsrc" [(500, True), (500, False)]
  d <- deriveCoverage operator auditor "vsrc"

  d.declaredTotal === 0
  d.declaredValue === 0
  d.attestedFloor === 0
  d.attestedValueFloor === 0
  d.auditorVisible === 1
  d.auditorVisibleValue === 500

  d.denominatorSource === AuditorVisible
  d.valueDenominatorSource === AuditorVisible
  d.ratio === 1.0
  d.valueRatio === 1.0
  assertMsg
    "an uncorroborated value denominator yields exactly 1.0, same as the count"
    (d.valueRatio == 1.0 && d.valueDenominatorSource == AuditorVisible)

  -- And the two sources can genuinely differ: attest the count but not in a
  -- way that bounds value higher than what the auditor sees.
  assertMsg
    "the two sources are computed independently"
    ( denominatorSourceOf 10 10 5 == AttestedFloor
        && denominatorSourceOf 0 0 500 == AuditorVisible
    )
